{
  "name": "cyberfox",
  "productName": "Cyberfox",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile QA workspace with AI-assisted scenarios",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js dist-electron/electron/preload.cjs && cross-env CYBERFOX_DEV=1 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder --publish never",
    "test:electron": "npm run build && node tests/electron-smoke.mjs",
    "format": "prettier --write src electron shared tests *.json *.ts index.html"
  },
  "dependencies": {
    "@github/copilot": "^1.0.103",
    "@github/copilot-sdk": "^1.0.26",
    "@openai/codex-sdk": "^0.164.0",
    "lucide-react": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pickywawa.cyberfox",
    "productName": "Cyberfox",
    "asarUnpack": [
      "node_modules/@openai/**",
      "node_modules/@github/**",
      "node_modules/@github/copilot*/**"
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "overrides": {
    "zod": "$zod"
  },
  "author": {
    "name": "pickywawa"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
